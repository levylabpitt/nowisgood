{
  "manifest_version": 3,
  "name": "nowisgood",
  "version": "0.1.0",
  "description": "Draft-fill WhenIsGood availability grids from your Google Calendar, then tweak. Optional click-through calendar overlay and meeting buffers.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["identity", "storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://whenisgood.net/*",
    "https://www.googleapis.com/*",
    "http://127.0.0.1:8788/*",
    "http://localhost:8788/*"
  ],
  "oauth2": {
    "client_id": "903947302397-es2qggvu1si5diqnkjp953gsd8af7nc6.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/calendar.readonly"]
  },
  "background": { "service_worker": "src/background.js" },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "nowisgood",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "options_ui": { "page": "src/options/options.html", "open_in_tab": true },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://whenisgood.net/*"],
      "js": ["src/content/fill.js"],
      "css": ["src/content/panel.css"],
      "run_at": "document_idle"
    }
  ]
}
